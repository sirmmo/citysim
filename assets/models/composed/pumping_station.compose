# Pumping station: a Kenney Factory Kit pump house with its pipe run, a
# valve and a small tank on a factory floor; the house faces the street
# (+z). CC0 parts.
variants = 8

[[slot]]
parts = ["../kenney/factory/floor-large.obj"]

[[slot]]
parts = ["../kenney/factory/machine-connection-pipe.obj", "../kenney/factory/machine.obj"]
size = [0.9, 1.1]
at = [0.1, 0.0, 0.8]
tints = [[1, 1, 1], [0.9, 0.95, 1.0]]

[[slot]]
parts = ["../kenney/factory/pipe-large-long.obj"]
size = [1.0, 0.5]
at = [0.5, 0.0, 0.15]

[[slot]]
parts = ["../kenney/factory/pipe-large-valve.obj"]
size = [0.5, 0.5]
at = [1.45, 0.0, 0.15]
rotations = [0, 180]

[[slot]]
parts = ["../kenney/factory/hopper-round.obj", "../kenney/factory/hopper-square.obj"]
size = [0.7, 0.7]
at = [1.2, 0.0, 1.15]

[[slot]]
parts = ["../kenney/factory/cone.obj", "../kenney/factory/warning-orange.obj", ""]
size = [0.12, 0.12]
at = [0.2, 0.0, 0.35]

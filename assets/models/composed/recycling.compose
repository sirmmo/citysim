# Recycling centre: a Kenney Factory Kit sorting machine fed by a
# conveyor, a hopper for what is sorted, crates and a robot arm; the
# machine faces the street (+z). CC0 parts.
variants = 8

[[slot]]
parts = ["../kenney/factory/floor-large.obj"]

[[slot]]
parts = ["../kenney/factory/machine.obj", "../kenney/factory/machine-window.obj"]
size = [0.85, 1.0]
at = [0.08, 0.0, 0.95]
tints = [[1, 1, 1], [0.95, 0.9, 0.85]]

[[slot]]
parts = ["../kenney/factory/conveyor-long.obj"]
size = [1.1, 0.55]
at = [0.85, 0.0, 0.3]

[[slot]]
parts = ["../kenney/factory/conveyor-corner.obj", "../kenney/factory/conveyor-stripe.obj"]
size = [0.55, 0.55]
at = [0.3, 0.0, 0.3]

[[slot]]
parts = ["../kenney/factory/hopper-square.obj", "../kenney/factory/hopper-high-square.obj"]
size = [0.6, 0.6]
at = [1.3, 0.0, 1.25]

[[slot]]
parts = ["../kenney/factory/box-wide.obj", "../kenney/factory/box-small.obj", "../kenney/factory/box-long.obj"]
size = [0.35, 0.35]
at = [0.98, 0.0, 1.55]
rotations = [0, 45, 90]

[[slot]]
parts = ["../kenney/factory/robot-arm-a.obj", ""]
size = [0.35, 0.35]
height = 0.9
at = [1.6, 0.0, 0.05]

[[slot]]
parts = ["../kenney/factory/cog-a.obj", ""]
size = [0.3, 0.3]
at = [0.05, 0.0, 0.05]
